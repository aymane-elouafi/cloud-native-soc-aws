{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListOnlyConfidentialPrefix",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::company-internal-data-lab",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "confidential-data/*"
                    ]
                }
            }
        },
        {
            "Sid": "ReadOnlyFakeConfidentialFiles",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::company-internal-data-lab/confidential-data/*"
        },
        {
            "Sid": "DiscoverBucketNames",
            "Effect": "Allow",
            "Action": "s3:ListAllMyBuckets",
            "Resource": "*"
        }
    ]
}
